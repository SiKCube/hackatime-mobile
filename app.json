{
  "expo": {
    "name": "Hackatime Mobile",
    "slug": "hackatime-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/hacka/icon.png",
    "scheme": "hackatimemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/hacka/foreground.png",
        "backgroundImage": "./assets/hacka/background.png",
        "monochromeImage": "./assets/hacka/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sikcube.hackatimemobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A2D31",
          "image": "./assets/hacka/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d0b00b5-4f7d-4289-8978-50a5ca470d2f"
      }
    },
    "owner": "sikcubes-team"
  }
}
